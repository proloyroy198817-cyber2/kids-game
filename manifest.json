body{
    margin:0;
    padding:0;
    text-align:center;
    font-family:Arial, sans-serif;
    background:linear-gradient(skyblue, white);
}

h1{
    margin-top:20px;
}

#score{
    font-size:30px;
    color:red;
    font-weight:bold;
}

#gameArea{
    width:100%;
    height:70vh;
    position:relative;
    overflow:hidden;
}

#balloon{
    width:80px;
    height:80px;
    border-radius:50%;
    background:red;
    position:absolute;
    left:50%;
    top:300px;
    cursor:pointer;
}
